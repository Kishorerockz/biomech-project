<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext ws:// and http:// to ESP32 on any private/hotspot IP -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Mobile hotspot subnet (iQOO Z9 5G assigns 10.133.x.x) -->
        <domain includeSubdomains="true">10.133.131.51</domain>
        <!-- Common Android hotspot subnets (192.168.43.x, 192.168.x.x) -->
        <domain includeSubdomains="true">192.168.43.1</domain>
        <domain includeSubdomains="true">192.168.0.1</domain>
        <!-- Localhost for dev -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
    <!-- Fallback: allow all cleartext for debug builds targeting LAN devices -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
